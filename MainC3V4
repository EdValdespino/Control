#include <esp_now.h>
#include <WiFi.h>

// MAC address del casco (receptor) - ¡CAMBIAR POR LA TUYA!
uint8_t receiverMac[] = {0x9C, 0xCC, 0x01, 0x7C, 0x46, 0x3C};

// --- PINES DEL CONTROL REMOTO ---
const int btnRight = 0;
const int btnCancel = 1;
const int btnLamp = 2;
const int btnHazard = 3;
const int btnLeft = 21;
const int pinBattery = 4; // ADC1

const int ledLamp = 5;       
const int ledHazard = 6;      
const int ledCancel = 7;  
const int ledRight = 10;
const int ledLeft = 20;

// Variables de estado
bool prevLeft = HIGH, prevRight = HIGH;
bool prevCancel = HIGH, prevLamp = HIGH, prevHazard = HIGH;
bool isDayMode = false;          
bool localLampState = false;     
unsigned long lampPressTime = 0; 
bool lampLongPressed = false;    

enum DirectionState { STATE_OFF, STATE_LEFT, STATE_RIGHT, STATE_HAZARD };
DirectionState currentState = STATE_OFF;

unsigned long previousTime = 0;
unsigned long prevFastBlink = 0;
unsigned long prevSendMillis = 0;
unsigned long prevSerialMillis = 0; 
const int blinkInterval = 400; 
bool flashState = false;
bool fastFlashState = false;
bool comboSosSent = false; 

// --- VARIABLES SOS (Recibidas del Casco) ---
bool isHelmetSOS = false;
const int sosPattern[] = {150, 150, 150, 150, 150, 450, 450, 150, 450, 150, 450, 450, 150, 150, 150, 150, 150, 1400};
const int sosPatternLength = 18;
int sosIndex = 0;
unsigned long previousSosTime = 0;

// Estructuras de datos ESP-NOW
typedef struct control_message {
  bool clickLeft;
  bool clickRight;
  bool clickCancel;
  bool clickLamp;
  bool clickHazard;
  uint8_t batteryPercent; 
} control_message;

typedef struct helmet_message {
  bool isSOS;
} helmet_message;

control_message dataToSend;
helmet_message incomingHelmetData;
esp_now_peer_info_t receiverInfo;

// Callbacks ESP-NOW
void onDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {}

void onDataRecv(const esp_now_recv_info_t * info, const uint8_t *incomingData, int len) {
  if (len == sizeof(helmet_message)) {
    memcpy(&incomingHelmetData, incomingData, sizeof(incomingHelmetData));
    isHelmetSOS = incomingHelmetData.isSOS;
    if (isHelmetSOS) {
      sosIndex = 0; // Reiniciar el patrón SOS
      previousSosTime = millis();
    }
  }
}

void setup() {
  Serial.begin(115200);
  
  pinMode(btnLeft, INPUT_PULLUP);
  pinMode(btnRight, INPUT_PULLUP);
  pinMode(btnCancel, INPUT_PULLUP);
  pinMode(btnLamp, INPUT_PULLUP);
  pinMode(btnHazard, INPUT_PULLUP);

  pinMode(ledLeft, OUTPUT);
  pinMode(ledRight, OUTPUT);
  pinMode(ledLamp, OUTPUT);
  pinMode(ledHazard, OUTPUT);
  pinMode(ledCancel, OUTPUT);

  digitalWrite(ledLeft, HIGH);
  digitalWrite(ledRight, HIGH);
  digitalWrite(ledLamp, HIGH);
  digitalWrite(ledHazard, HIGH);
  digitalWrite(ledCancel, HIGH);

  analogReadResolution(12);
  WiFi.mode(WIFI_MODE_STA);
  esp_now_init();
  esp_now_register_send_cb((esp_now_send_cb_t)onDataSent);
  esp_now_register_recv_cb(onDataRecv); // Escuchar al casco

  memcpy(receiverInfo.peer_addr, receiverMac, 6);
  receiverInfo.channel = 0;  
  receiverInfo.encrypt = false;
  esp_now_add_peer(&receiverInfo);
}

void loop() {
  unsigned long currentMillis = millis();

  int adcValue = analogRead(pinBattery);
  float batVoltage = ((adcValue * 3.3) / 4095.0) * 2.0; 
  int batPercent = constrain((batVoltage - 3.2) * 100.0 / (4.2 - 3.2), 0, 100); 

  if (currentMillis - prevSerialMillis >= 2000) {
    prevSerialMillis = currentMillis;
    Serial.print("Bateria Control: "); Serial.print(batPercent); Serial.println("%");
  }

  bool currentLeft = digitalRead(btnLeft);
  bool currentRight = digitalRead(btnRight);
  bool currentCancel = digitalRead(btnCancel);
  bool currentLamp = digitalRead(btnLamp);
  bool currentHazard = digitalRead(btnHazard);
  bool shouldSend = false;
  dataToSend = {false, false, false, false, false, (uint8_t)batPercent};

  // Combo SOS Cancel
  bool comboActive = (currentCancel == LOW && currentHazard == LOW);
  if (comboActive) {
    if (!comboSosSent) {
      dataToSend.clickCancel = true;
      dataToSend.clickHazard = true;
      shouldSend = true;
      comboSosSent = true; 
      currentState = STATE_OFF; 
      isHelmetSOS = false; // Apagar la alerta en el control inmediatamente
      Serial.println("¡COMBO SOS CANCEL ENVIADO!");
    }
  } else {
    comboSosSent = false;
    if (currentLeft == LOW && prevLeft == HIGH) { dataToSend.clickLeft = true; shouldSend = true; currentState = STATE_LEFT; }
    if (currentRight == LOW && prevRight == HIGH) { dataToSend.clickRight = true; shouldSend = true; currentState = STATE_RIGHT; }
    if (currentCancel == LOW && prevCancel == HIGH) { dataToSend.clickCancel = true; shouldSend = true; currentState = STATE_OFF; }
    if (currentHazard == LOW && prevHazard == HIGH) { 
      dataToSend.clickHazard = true; shouldSend = true; 
      currentState = (currentState == STATE_HAZARD) ? STATE_OFF : STATE_HAZARD; 
    }
  }

  // Pulsación Larga (Lámpara)
  if (currentLamp == LOW && prevLamp == HIGH) { lampPressTime = currentMillis; lampLongPressed = false; }
  if (currentLamp == LOW && !lampLongPressed) {
    if (currentMillis - lampPressTime >= 3000) { 
      isDayMode = !isDayMode; 
      lampLongPressed = true; 
    }
  }
  if (currentLamp == HIGH && prevLamp == LOW) {
    if (!lampLongPressed) { 
      dataToSend.clickLamp = true; 
      shouldSend = true; 
      localLampState = !localLampState; 
    }
  }

  // Tiempos de parpadeo
  if (currentMillis - previousTime >= blinkInterval) { previousTime = currentMillis; flashState = !flashState; }
  if (currentMillis - prevFastBlink >= 150) { prevFastBlink = currentMillis; fastFlashState = !fastFlashState; }

  // --- APLICACIÓN DE ESTADOS A LOS LEDS ---
  if (isHelmetSOS) {
    // Si hay impacto, el control toma el control total y parpadea en SOS
    if (currentMillis - previousSosTime >= sosPattern[sosIndex]) {
      previousSosTime = currentMillis;
      sosIndex++;
      if (sosIndex >= sosPatternLength) sosIndex = 0;
    }
    bool currentSosState = (sosIndex % 2 == 0); 
    digitalWrite(ledLeft, currentSosState);
    digitalWrite(ledRight, currentSosState);
    digitalWrite(ledLamp, currentSosState);
    digitalWrite(ledHazard, currentSosState);
    digitalWrite(ledCancel, currentSosState);
  } else {
    // Funcionamiento normal Día/Noche
    bool baseState = isDayMode ? LOW : HIGH;
    digitalWrite(ledLamp, isDayMode ? localLampState : HIGH); 

    if (batPercent < 30) {
      digitalWrite(ledCancel, fastFlashState);
    } else {
      digitalWrite(ledCancel, baseState);
    }

    if (currentState == STATE_LEFT) {
      digitalWrite(ledLeft, flashState); digitalWrite(ledRight, baseState); digitalWrite(ledHazard, baseState);     
    } else if (currentState == STATE_RIGHT) {
      digitalWrite(ledLeft, baseState); digitalWrite(ledRight, flashState); digitalWrite(ledHazard, baseState);     
    } else if (currentState == STATE_HAZARD) {
      digitalWrite(ledLeft, flashState); digitalWrite(ledRight, flashState); digitalWrite(ledHazard, flashState);
    } else { 
      digitalWrite(ledLeft, baseState); digitalWrite(ledRight, baseState); digitalWrite(ledHazard, baseState);     
    }
  }

  // Transmisión
  if (currentMillis - prevSendMillis >= 5000) { shouldSend = true; prevSendMillis = currentMillis; }
  if (shouldSend) {
    esp_now_send(receiverMac, (uint8_t *) &dataToSend, sizeof(dataToSend));
    if ((dataToSend.clickLeft || dataToSend.clickRight || dataToSend.clickCancel || dataToSend.clickLamp || dataToSend.clickHazard) && !lampLongPressed && !comboActive) {
      delay(200); 
    }
  }

  prevLeft = currentLeft; prevRight = currentRight; prevCancel = currentCancel;
  prevLamp = currentLamp; prevHazard = currentHazard;
  delay(10);
}
